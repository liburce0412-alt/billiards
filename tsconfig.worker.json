{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types", "node"],
    "noEmit": true
  },
  "include": ["server/**/*.ts", "server/worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", "src", "test"]
}
