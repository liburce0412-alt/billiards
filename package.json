{
  "name": "billiards",
  "description": "Break Builder 3D - a deterministic browser billiards simulation with five rulesets and 11-level local AI",
  "version": "0.4.0",
  "author": "Break Builder contributors",
  "homepage": "https://play.campus3ai.xyz/",
  "repository": {
    "type": "git",
    "url": "https://github.com/liburce0412-alt/billiards.git"
  },
  "bugs": {
    "url": "https://github.com/liburce0412-alt/billiards/issues"
  },
  "keywords": [
    "billiards",
    "snooker",
    "threejs",
    "swc",
    "physics",
    "webgl",
    "pool-game",
    "browser-game"
  ],
  "license": "GPL-3.0",
  "sideEffects": false,
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "test": "jest --config ./test/jest.config.js --verbose --silent",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "coverage": "jest --config ./test/jest.config.js --coverage --silent",
    "version-gen": "node -e \"const d=new Date();const v=d.getFullYear().toString().slice(-2)+('0'+(d.getMonth()+1)).slice(-2)+('0'+d.getDate()).slice(-2)+'.'+('0'+d.getHours()).slice(-2);require('fs').writeFileSync('src/utils/version.ts', 'export const VERSION = \\'' + v + '\\';\\n')\"",
    "assets:table-tennis": "node packages/table-tennis/scripts/prepare-assets.mjs --target dist/models/table-tennis",
    "dev": "npm run assets:table-tennis && webpack",
    "build": "npm run assets:table-tennis && npm run version-gen && webpack && node scripts/prepare-sites.cjs",
    "lint": "tsc --noEmit && eslint .",
    "lint:css": "stylelint \"dist/css/**/*.css\" \"dist/{index,rules}.html\"",
    "prettify": "prettier --cache true --write --trailing-comma es5 --no-semi \"src/**/*.[jt]s\" \"test/**/*.[jt]s\" \"server/**/*.ts\" \"scripts/**/*.cjs\" \"dist/**/*.{css,html}\" \"*.{js,mjs,json,jsonc,ts,mts,css}\"",
    "markdownlint": "npx markdownlint-cli2 README.md CHANGELOG.md SECURITY.md \"docs/*.md\" .github/CONTRIBUTING.md",
    "worker:types": "wrangler types server/worker-configuration.d.ts",
    "worker:dev": "wrangler dev",
    "worker:test": "vitest run --config vitest.worker.config.mts",
    "db:migrate:local": "wrangler d1 migrations apply break-builder-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply break-builder-prod --remote",
    "audit:origins": "node scripts/check-external-origins.cjs",
    "deploy": "npm run build && npm run audit:origins && wrangler deploy",
    "serve": "concurrently \"npm run watch\" \"npm run start-server\"",
    "start-server": "http-server dist -p 8080 -c-1",
    "watch": "npm run assets:table-tennis && webpack --watch",
    "deps": "npx yarn-check --skip-unused",
    "gltfpack": "npx gltfpack -i dist/models/p8.gltf -o dist/models/p8.min.gltf && npx gltfpack -i dist/models/threecushion.gltf -o dist/models/threecushion.min.gltf && npx gltfpack -i dist/models/snooker.gltf -o dist/models/snooker.min.gltf && npx gltfpack -i dist/models/d-snooker.gltf -o dist/models/d-snooker.min.gltf"
  },
  "dependencies": {
    "@phosphor-icons/web": "2.1.2",
    "better-auth": "1.6.27",
    "interactjs": "1.10.27",
    "jsoncrush": "^1.1.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "three": "0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.2",
    "@cloudflare/workers-types": "5.20260812.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@swc/core": "1.15.46",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/chai": "5.2.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.1",
    "canvas": "3.2.3",
    "chai": "6.2.2",
    "concurrently": "10.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-sonarjs": "4.2.0",
    "http-server": "^14.1.1",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "node-notifier": "^10.0.1",
    "postcss-html": "^1.8.1",
    "prettier": "3.9.5",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "swc-loader": "0.2.7",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.1",
    "webpack-dev-server": "6.0.0",
    "wrangler": "4.122.0"
  }
}
